# Local development defaults to SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgresql://raw:replace-with-a-secret@localhost:5432/raw
RAW_DATABASE_PATH=raw.db
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo mode accepts only the seeded X-Actor-Id identities.
AUTH_MODE=demo
# Production OIDC mode requires all values below. Do not commit provider credentials or private keys.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com/tenant/v2.0
# OIDC_AUDIENCE=risk-assessment-api
# OIDC_JWKS_URL=https://identity.example.com/tenant/discovery/v2.0/keys
# OIDC_ROLE_CLAIM=fcrm_role

# Assessment drafts use the deterministic adapter by default. Unknown adapters fail closed,
# record a failed execution ledger event, and leave the case in analyst review.
AI_ADAPTER=deterministic-mock-v1
# To use Claude for analyst-facing drafts, configure deployment secrets rather than committing keys:
# AI_ADAPTER=anthropic-claude
# ANTHROPIC_API_KEY=managed-by-your-deployment-secret-store
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_SECONDS=30
# Comma-separated browser origins allowed to call the API. Use the public HTTPS workbench URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
